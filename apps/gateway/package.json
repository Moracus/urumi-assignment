{
  "name": "@urumi/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup-admin": "node dist/identity/setup-cli.js",
    "recover-admin": "node dist/identity/recovery-cli.js",
    "test": "node --test --test-concurrency=1 dist/app.test.js dist/execution/*.test.js dist/tools/*.test.js dist/identity/*.integration.test.js",
    "test:integration": "bash ../../infra/mongodb/test.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/fastify": "^2.0.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.0.0",
    "mongoose": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
