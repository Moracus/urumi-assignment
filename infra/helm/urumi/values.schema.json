{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "networkPolicy": {
      "type": "object",
      "required": [
        "gatewayEgress"
      ],
      "properties": {
        "gatewayEgress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dns",
            "mongodb",
            "kubernetesApi",
            "additionalDestinations",
            "chatProvider"
          ],
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace",
                "podLabels",
                "serviceCidrs"
              ],
              "properties": {
                "namespace": {
                  "$ref": "#/definitions/namespace"
                },
                "podLabels": {
                  "$ref": "#/definitions/podLabels"
                },
                "serviceCidrs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/hostCidr"
                  }
                }
              }
            },
            "mongodb": {
              "$ref": "#/definitions/peers"
            },
            "kubernetesApi": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ipPeer"
              }
            },
            "additionalDestinations": {
              "$ref": "#/definitions/peers"
            },
            "chatProvider": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cidr",
                  "ports"
                ],
                "properties": {
                  "cidr": {
                    "$ref": "#/definitions/hostCidr"
                  },
                  "ports": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "const": 443
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "authSecretName",
        "storage",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authSecretName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "chat"
      ],
      "properties": {
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "provider",
            "model",
            "secretName",
            "secretKey"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "enum": [
                "openai"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?([.][a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "secretName": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "podLabels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "hostCidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32|([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}/128)$"
    },
    "tcpPorts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "ipPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cidr",
        "ports"
      ],
      "properties": {
        "cidr": {
          "$ref": "#/definitions/hostCidr"
        },
        "ports": {
          "$ref": "#/definitions/tcpPorts"
        }
      }
    },
    "podPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "podLabels",
        "ports"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/definitions/namespace"
        },
        "podLabels": {
          "$ref": "#/definitions/podLabels"
        },
        "ports": {
          "$ref": "#/definitions/tcpPorts"
        }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/ipPeer"
          },
          {
            "$ref": "#/definitions/podPeer"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gateway": {
            "properties": {
              "chat": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "gatewayEgress": {
                "properties": {
                  "chatProvider": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
