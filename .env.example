# Host development: copy to .env, then fill the blank credentials.
# Existing shell variables take precedence. Kubernetes uses Helm values/Secrets.
# Do not set shared PORT: it would put every backend on the same port.
HOST=127.0.0.1
GATEWAY_PORT=3000
WOOCOMMERCE_MCP_PORT=3001
CALCULATOR_MCP_PORT=3002
TIME_MCP_PORT=3003
DASHBOARD_PORT=5173
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose local replica set (infra/mongodb/compose.yaml).
MONGODB_URI=mongodb://127.0.0.1:27017/urumi?replicaSet=urumi&directConnection=true
# Choose a private random setup secret. Used by setup-admin only, never MCP.
GATEWAY_BOOTSTRAP_KEY=

# Dashboard and gateway running on the host.
DASHBOARD_PROXY_TARGET=http://127.0.0.1:3000
DASHBOARD_TRUSTED_ORIGINS=http://localhost:5173
DASHBOARD_ALLOW_HTTP=true
DASHBOARD_TRUSTED_PROXIES=
# Public connection information only; Helm uses dashboard.publicMcpUrl.
DASHBOARD_PUBLIC_MCP_URL=http://localhost:3000/mcp

# Optional server-only dashboard chat. Never prefix this with VITE_.
# OpenAI endpoint is fixed; model must support the existing tool-call protocol.
# Unset CHAT_ENABLED uses key-driven availability; false explicitly disables chat.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_API_KEY=

# Local upstream approval is explicit and restricted to these loopback ports.
WOOCOMMERCE_MCP_URL=http://127.0.0.1:3001/mcp
CALCULATOR_MCP_URL=http://127.0.0.1:3002/mcp
TIME_MCP_URL=http://127.0.0.1:3003/mcp
UPSTREAM_ALLOW_LOOPBACK=true
UPSTREAM_DESTINATION_RULES='[{"origin":"http://127.0.0.1:3001","cidrs":["127.0.0.1/32"]},{"origin":"http://127.0.0.1:3002","cidrs":["127.0.0.1/32"]},{"origin":"http://127.0.0.1:3003","cidrs":["127.0.0.1/32"]}]'

# Storefront reached through the Kind Traefik port-forward below.
# Must equal the canonical WordPress site URL, including scheme and port.
WC_URL=http://store.localhost:8080
# Optional destination override; uncomment only when needed (signing uses WC_URL).
# WC_INTERNAL_URL=http://127.0.0.1:8080
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
